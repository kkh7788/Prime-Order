/* ─── Design Tokens ─────────────────────────────────────────── */
page {
  /* Color */
  --color-primary:        #244C40;
  --color-primary-light:  #719083;
  --color-primary-dark:   #17392F;
  --color-primary-tint:   #EAF0E9;   /* 8% primary on white */

  --color-bg:             #F6F4EF;
  --color-bg-subtle:      #F6F4EF;   /* near-white with warm undertone */
  --color-surface:        #FFFFFF;

  --color-text-primary:   #222E28;
  --color-text-secondary: #647067;
  --color-text-muted:     #7C847C;
  --color-border:         #E4E6DD;
  --color-divider:        #EEEFE8;

  /* Spacing (8rpx base grid) */
  --space-1:  8rpx;
  --space-2:  16rpx;
  --space-3:  24rpx;
  --space-4:  32rpx;
  --space-5:  40rpx;
  --space-6:  48rpx;
  --space-8:  64rpx;
  --space-10: 80rpx;
  --space-12: 96rpx;

  /* Border radius */
  --radius-sm:   8rpx;
  --radius-md:   16rpx;
  --radius-lg:   24rpx;
  --radius-xl:   32rpx;
  --radius-pill: 999rpx;

  /* Typography */
  --text-xs:   20rpx;
  --text-sm:   24rpx;
  --text-base: 28rpx;
  --text-md:   32rpx;
  --text-lg:   36rpx;
  --text-xl:   44rpx;
  --text-2xl:  56rpx;
  --text-3xl:  72rpx;

  --leading-tight:   1.3;
  --leading-normal:  1.6;
  --leading-relaxed: 1.8;

  --tracking-tight:  -0.02em;
  --tracking-normal:  0em;
  --tracking-wide:    0.04em;
  --tracking-wider:   0.08em;

  /* Elevation (forest-tinted shadows) */
  --shadow-sm: 0 2rpx 12rpx  rgba(36, 76, 64, 0.06);
  --shadow-md: 0 4rpx 24rpx  rgba(36, 76, 64, 0.10);
  --shadow-lg: 0 8rpx 40rpx  rgba(36, 76, 64, 0.14);
  --shadow-xl: 0 16rpx 64rpx rgba(36, 76, 64, 0.18);

  /* ─── Base styles ─────────────────────────────────────────── */
  background-color: var(--color-bg);
  color: var(--color-text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  -webkit-font-smoothing: antialiased;
}

page, view, text, image, button, input, textarea, scroll-view, swiper, swiper-item {
  box-sizing: border-box;
}

/* ─── Floating customer service entry ─────────────────────────── */
button.customer-service-fab {
  position: fixed;
  left: 24rpx;
  bottom: 40rpx;
  width: 124rpx;
  height: 124rpx;
  min-width: 124rpx;
  max-width: 124rpx;
  min-height: 124rpx;
  max-height: 124rpx;
  margin: 0;
  padding: 0;
  z-index: 60;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(36, 76, 64, 0.20);
  border-radius: 50%;
  box-shadow: 0 10rpx 26rpx rgba(31, 27, 36, 0.12);
  line-height: 1.15;
  font-size: 22rpx;
  overflow: hidden;
}

button.customer-service-fab--raised {
  bottom: 152rpx;
}

button.customer-service-fab--high {
  bottom: 184rpx;
}

button.customer-service-fab--pressed {
  background-color: #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(31, 27, 36, 0.10);
}

button.customer-service-fab::after {
  border: none;
}

.customer-service-fab__icon {
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 6rpx;
  flex-shrink: 0;
}

.customer-service-fab__label {
  display: block;
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.15;
  white-space: nowrap;
}

/* Quiet surfaces, readable secondary text, small tactile feedback. */
button { font-weight: 500; }
button.customer-service-fab { left: auto; right: 24rpx; width: 88rpx; min-width: 88rpx; max-width: 88rpx; height: 88rpx; min-height: 88rpx; max-height: 88rpx; border-radius: 28rpx; box-shadow: 0 4rpx 18rpx rgba(28,47,37,.08); }
.customer-service-fab__icon { width: 32rpx; height: 32rpx; margin-bottom: 4rpx; }
.customer-service-fab__label { font-size: 18rpx; font-weight: 500; }
button.customer-service-fab--high { bottom: calc(160rpx + env(safe-area-inset-bottom)); }
.state-action { display: inline-flex; justify-content: center; align-items: center; min-height: 80rpx; padding: 0 36rpx; margin-top: 28rpx; border-radius: 16rpx; background: var(--color-primary); color: #fff; font-size: 26rpx; }
.skeleton-line { height: 24rpx; width: 72%; border-radius: 8rpx; background: #E8EBE2; margin: 16rpx 0; }
.skeleton-line--short { width: 42%; }
