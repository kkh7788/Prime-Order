.home-page { padding: 30rpx 32rpx 100rpx; }
.home-brand { display: flex; align-items: center; margin: 0 0 32rpx; }
.brand-mark { width: 66rpx; height: 66rpx; border: 1rpx solid #244C40; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 34rpx; color: #244C40; margin-right: 18rpx; font-family: 'Songti SC',serif; }
.brand-name { display: block; font-size: 30rpx; font-weight: 600; letter-spacing: 1rpx; }
.brand-note { display: block; font-size: 20rpx; margin-top: 2rpx; color: var(--color-text-secondary); }
.brand-edition { margin-left: auto; font-size: 20rpx; color: var(--color-text-secondary); letter-spacing: 3rpx; }
.home-hero { position: relative; min-height: 490rpx; overflow: hidden; border-radius: 24rpx; background: #244C40; }
.hero-art { position: absolute; width: 410rpx; height: 410rpx; right: -65rpx; bottom: -54rpx; opacity: .96; }
.hero-photo,.hero-shade { position: absolute; width: 100%; height: 100%; top: 0; left: 0; }
.hero-shade { background: linear-gradient(90deg,rgba(18,40,31,.9),rgba(18,40,31,.22)); }
.hero-copy { position: relative; z-index: 1; padding: 42rpx 36rpx 82rpx; }
.hero-eyebrow { color: #CCD8BA; font-size: 17rpx; letter-spacing: 4rpx; }
.hero-title { display: block; white-space: pre-line; font-size: 56rpx; line-height: 1.38; color: #F9F5E9; font-family: 'Songti SC','STSong',serif; margin: 26rpx 0 18rpx; letter-spacing: 3rpx; }
.hero-subtitle { display: block; font-size: 23rpx; color: #CDD8CC; }
.hero-button { display: flex; justify-content: space-between; align-items: center; width: 228rpx; height: 76rpx; margin: 30rpx 0 0; padding: 0 26rpx; border-radius: 12rpx; background: #E9EDDB; color: #244C40; font-size: 26rpx; line-height: 1; }
.hero-button::after { border: 0; }.hero-button text { font-size: 32rpx; }.button-pressed { opacity: .85; }
.hero-caption { position: absolute; bottom: 22rpx; left: 36rpx; color: #BDCCBC; font-size: 18rpx; letter-spacing: 3rpx; }
.home-shortcuts { display: flex; margin: 22rpx 0 46rpx; background: #FFFEFA; border: 1rpx solid var(--color-border); border-radius: 18rpx; }
.shortcut { flex: 1; min-width: 0; padding: 26rpx 18rpx; display: flex; align-items: center; }.shortcut + .shortcut { border-left: 1rpx solid var(--color-border); }
.shortcut image { width: 38rpx; height: 38rpx; flex-shrink: 0; margin-right: 14rpx; }.shortcut-title { display: block; font-size: 24rpx; font-weight: 600; }.shortcut-sub { display: block; font-size: 18rpx; color: var(--color-text-secondary); margin-top: 6rpx; }.shortcut-arrow { margin-left: auto; color: #818B7C; }
.home-section-heading { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24rpx; }.section-eyebrow { display: block; font-size: 17rpx; color: #73816F; letter-spacing: 3rpx; }.home-section-title { display: block; font-size: 34rpx; margin-top: 6rpx; font-weight: 600; }.menu-link { color: #244C40; font-size: 22rpx; padding: 12rpx 0 8rpx 10rpx; }.menu-link text { padding-left: 8rpx; }
.featured-list { border-radius: 20rpx; border: 1rpx solid var(--color-border); background: #FFFEFA; overflow: hidden; }.featured-card { display: flex; align-items: center; padding: 24rpx; }.featured-card + .featured-card { border-top: 1rpx solid var(--color-divider); }.featured-image { width: 140rpx; height: 140rpx; flex-shrink: 0; border-radius: 14rpx; }.featured-copy { flex: 1; min-width: 0; margin: 0 22rpx; }.featured-name { display: block; font-size: 28rpx; font-weight: 600; }.featured-desc { display: block; font-size: 22rpx; color: #73806F; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; margin: 7rpx 0 14rpx; }.featured-price { font-size: 28rpx; font-weight: 600; color: #244C40; }.featured-suffix { font-size: 18rpx; font-weight: 400; margin-left: 5rpx; }.featured-arrow { font-size: 27rpx; color: #244C40; }.surface-pressed { background: #F0F2E9; }
.featured-loading,.home-empty { padding: 36rpx; border-radius: 20rpx; background: #FFFEFA; }.home-empty { display: flex; flex-direction: column; align-items: center; color: var(--color-text-secondary); font-size: 26rpx; }.home-empty-sub { font-size: 22rpx; margin-top: 10rpx; text-align: center; }
.home-footer { display: flex; align-items: center; justify-content: center; margin-top: 44rpx; font-size: 20rpx; color: #858D7C; letter-spacing: 2rpx; }.footer-line { height: 1rpx; background: #DADFD1; width: 44rpx; margin: 0 18rpx; }
